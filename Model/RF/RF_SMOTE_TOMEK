ain, X_fold_val = X_resampled[train_idx], X_resampled[val_idx]\n","    y_fold_train, y_fold_val = y_resampled[train_idx], y_resampled[val_idx]\n","\n","    rf = RandomForestClassifier(random_state=42)\n","    rf.fit(X_fold_train, y_fold_train)\n","\n","    y_pred = rf.predict(X_fold_val)\n","    y_pred_proba = rf.predict_proba(X_fold_val)\n","\n","    acc = accuracy_score(y_fold_val, y_pred)\n","    precision = precision_score(y_fold_val, y_pred, average='weighted', zero_division=0)\n","    recall = recall_score(y_fold_val, y_pred, average='weighted', zero_division=0)\n","    f1 = f1_score(y_fold_val, y_pred, average='weighted', zero_division=0)\n","    y_bin = label_binarize(y_fold_val, classes=list(range(n_classes)))\n","    auc = roc_auc_score(y_bin, y_pred_proba, average='macro', multi_class='ovo')\n","\n","    accuracies.append(acc)\n","    precisions.append(precision)\n","    recalls.append(recall)\n","    f1_scores.append(f1)\n","    auc_scores.append(auc)\n","\n","    print(f\"Fold {fold}: Acc={acc:.3f}, Prec={precision:.3f}, Rec={recall:.3f}, F1={f1:.3f}, AUC={auc:.3f}\")\n"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"mmin3DSABX1h"},"outputs":[],"source":["# --- Final Train/Test ---\n","rf_final = RandomForestClassifier(random_state=42)\n","rf_final.fit(X_resampled, y_resampled)\n","y_pred_test = rf_final.predict(X_test)\n","y_pred_proba_test = rf_final.predict_proba(X_test)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"RZW_l7HLBbSX"},"outputs":[],"source":["# --- Test Metrics ---\n","test_accuracy = accuracy_score(y_test, y_pred_test)\n","test_precision = precision_score(y_test, y_pred_test, average='weighted', zero_division=0)\n","test_recall = recall_score(y_test, y_pred_test, average='weighted', zero_division=0)\n","test_f1 = f1_score(y_test, y_pred_test, average='weighted', zero_division=0)\n","test_auc = roc_auc_score(\n","    label_binarize(y_test, classes=list(range(n_classes))),\n","    y_pred_proba_test,\n","    average='macro',\n","    multi_class='ovo'\n",")\n","\n","print(\"\\n📊 Cross-validation (10 folds) Metrics per Fold:\")\n","for i in range(len(accuracies)):\n","    print(f\"Fold {i+1}: \"\n","          f\"Acc={accuracies[i]:.3f}, \"\n","          f\"Prec={precisions[i]:.3f}, \"\n","          f\"Rec={recalls[i]:.3f}, \"\n","          f\"F1={f1_scores[i]:.3f}, \"\n","          f\"AUC={auc_scores[i]:.3f}\")\n","\n","# --- Mean and SD summary ---\n","acc_mean, acc_sd = np.mean(accuracies), np.std(accuracies)\n","prec_mean, prec_sd = np.mean(precisions), np.std(precisions)\n","rec_mean, rec_sd = np.mean(recalls), np.std(recalls)\n","f1_mean, f1_sd = np.mean(f1_scores), np.std(f1_scores)\n","auc_mean, auc_sd = np.mean(auc_scores), np.std(auc_scores)\n","\n","print(\"\\n📊 Cross-validation (10 folds) Avg ± SD:\")\n","print(f\"Accuracy : {acc_mean:.3f} ± {acc_sd:.3f}\")\n","print(f\"Precision: {prec_mean:.3f} ± {prec_sd:.3f}\")\n","print(f\"Recall   : {rec_mean:.3f} ± {rec_sd:.3f}\")\n","print(f\"F1-score : {f1_mean:.3f} ± {f1_sd:.3f}\")\n","print(f\"AUC      : {auc_mean:.3f} ± {auc_sd:.3f}\")\n","\n","print(\"\\n📈 Test Set Metrics:\")\n","print(f\"Accuracy: {test_accuracy:.3f}, Precision: {test_precision:.3f}, \"\n","      f\"Recall: {test_recall:.3f}, F1: {test_f1:.3f}, AUC: {test_auc:.3f}\")\n","\n","print(\"\\nClassification Report:\\n\",\n","      classification_report(\n","          y_test, y_pred_test,\n","          target_names=['Good', 'Moderate', 'Unhealthy for Sensitive', 'Unhealthy', 'Very Unhealthy'],\n","          zero_division=0\n","      ))\n","print(\"Confusion Matrix:\\n\", confusion_matrix(y_test, y_pred_test))\n"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"8SwQ2UfPBcCR"},"outputs":[],"source":["# =====================================================\n","# 🆕 SAVE ROC DATA (for ROC Curve plotting)\n","# =====================================================\n","print(\"💾 กำลังบันทึกข้อมูลสำหรับพล็อต ROC Curve...\")\n","\n","# --- Save y