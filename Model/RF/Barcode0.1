2.imread('IMG_1770.jpg')\n","if img is None:\n","    raise FileNotFoundError(\"ไม่พบไฟล์ cropped_barcode_qrcode1.jpg\")\n","\n","# ----------------------------\n","# STEP 3: Convert to grayscale\n","# ----------------------------\n","gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n","\n","# ----------------------------\n","# STEP 4: Decode\n","# ----------------------------\n","decoded_objects = decode(gray)\n","\n","# ----------------------------\n","# STEP 5: Draw results on image\n","# ----------------------------\n","for obj in decoded_objects:\n","    x, y, w, h = obj.rect\n","    cv2.rectangle(img, (x, y), (x+w, y+h), (0, 255, 0), 2)\n","    barcode_data = obj.data.decode('utf-8')\n","    barcode_type = obj.type\n","    cv2.putText(img, f'{barcode_data} ({barcode_type})', (x, y-10),\n","                cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0,255,0), 2)\n","    print(f\"Data: {barcode_data}\")\n","    print(f\"Type: {barcode_type}\")\n","    print(\"------------------------\")\n","\n","# ----------------------------\n","# STEP 6: Display image\n","# ----------------------------\n","plt.figure(figsize=(8,6))\n","plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))\n","plt.axis('off')\n","plt.title('Detected Barcode / QR Code')\n","plt.show()\n","\n","# ----------------------------\n","# STEP 7: เซฟรูปลงไฟล์\n","# ----------------------------\n","save_path = '/content/detected_barcode_qrcode2.jpg'\n","cv2.imwrite(save_path, img)\n","print(f\"✅ บันทึกภาพสำเร็จที่: {save_path}\")\n","\n","# ----------------------------\n","# STEP 8: กรณีไม่พบ\n","# ----------------------------\n","if len(decoded_objects) == 0:\n","    print(\"❌ ไม่พบ Barcode หรือ QR Code\")\n"]}]}