{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPeNj0G7yM6q3e75CQGDMK/"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":10,"metadata":{"id":"S7MpQXPvZWLw","executionInfo":{"status":"ok","timestamp":1762239022736,"user_tz":-420,"elapsed":2,"user":{"displayName":"Oh my gust","userId":"09009155263349941429"}}},"outputs":[],"source":["# ======================= Random Forest with SMOTE + CSV Save =======================\n","import pandas as pd\n","import numpy as np\n","from sklearn.model_selection import KFold\n","from sklearn.preprocessing import label_binarize\n","from sklearn.metrics import (\n","    accuracy_score, classification_report, confusion_matrix,\n","    precision_score, recall_score, f1_score, roc_auc_score\n",")\n","from sklearn.ensemble import RandomForestClassifier\n","from imblearn.over_sampling import SMOTE\n"]},{"cell_type":"code","source":["# --- Load Train/Test Split Files ---\n","train_df = pd.read_csv(\"train_split.csv\")\n","test_df = pd.read_csv(\"test_split.csv\")"],"metadata":{"id":"Hgl7tmvRZzPy","executionInfo":{"status":"ok","timestamp":1762239023815,"user_tz":-420,"elapsed":1050,"user":{"displayName":"Oh my gust","userId":"09009155263349941429"}}},"execution_count":11,"outputs":[]},{"cell_type":"code","source":["# --- แยก X, y จากไฟล์ (ไม่ต้อง define features เอง) ---\n","X_train = train_df.drop(columns=[\"PM2.5_level\"]).values\n","y_train = train_df[\"PM2.5_level\"].values - 1  # ปรับ label ให้เริ่มที่ 0\n","\n","X_test = test_df.drop(columns=[\"PM2.5_level\"]).values\n","y_test = test_df[\"PM2.5_level\"].values - 1\n","\n","n_classes = len(np.unique(y_train))"],"metadata":{"id":"UjOYT51lZzM7","executionInfo":{"status":"ok","timestamp":1762239023969,"user_tz":-420,"elapsed":151,"user":{"displayName":"Oh my gust","userId":"09009155263349941429"}}},"execution_count":12,"outputs":[]},{"cell_type":"code","source":["# --- Show original class distribution ---\n","class_counts = np.bincount(y_train)\n","print(\"\\n📊 Original Class Distribution:\")\n","for i, c in enumerate(class_counts, 1):\n","    print(f\"Class {i}: {c}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"4IrRdY6KZzJI","executionInfo":{"status":"ok","timestamp":1762239023973,"user_tz":-420,"elapsed":3,"user":{"displayName":"Oh my gust","userId":"09009155263349941429"}},"outputId":"72b1ca63-7986-4a76-c6ba-eb8e5f1671ab"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","📊 Original Class Distribution:\n","Class 1: 64314\n","Class 2: 33504\n","Class 3: 29942\n","Class 4: 73062\n","Class 5: 128801\n"]}]},{"cell_type":"code","source":["# --- Apply Original SMOTE only for classes 2 and 3 ---\n","print(\"\\n⚙️ Applying Original SMOTE for classes 2 and 3 ...\")\n","\n","# class 5 = index 4 → max class count\n","max_class = np.max(class_counts)\n","target_count = int(max_class / 2)  # ครึ่งหนึ่งของ class ที่มากที่สุด\n","print(f\"Target samples for class 2 & 3 after SMOTE ≈ {target_count}\")\n","\n","# แยก class 2,3 และ class อื่น ๆ\n","mask_target = np.isin(y_train, [1, 2])  # class 2 และ 3 (index เริ่มจาก 0)\n","X_target = X_train[mask_target]\n","y_target = y_train[mask_target]\n","\n","X_rest = X_train[~mask_target]\n","y_rest = y_train[~mask_target]\n","\n","# สร้าง sampling strategy แบบกำหนดเอง\n","sampling_strategy = {\n","    1: target_count,  # class 2\n","    2: target_count   # class 3\n","}\n","\n","# ทำ Original SMOTE กับ class 2 และ 3 เท่านั้น\n","smote = SMOTE(random_state=42, sampling_strategy=sampling_strategy)\n","X_target_res, y_target_res = smote.fit_resample(X_target, y_target)\n","\n","# รวมกลับเข้ากับชุดข้อมูลทั้งหมด\n","X_train_res = np.vstack((X_rest, X_target_res))\n","y_train_res = np.concatenate((y_rest, y_target_res))\n","\n","# --- ตรวจสอบ distribution ใหม่ ---\n","new_counts = np.bincount(y_train_res)\n","print(\"\\n📈 After Original SMOTE:\")\n","for i, c in enumerate(new_counts, 1):\n","    print(f\"Class {i}: {c}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"qQtzR4NEZzE2","executionInfo":{"status":"ok","timestamp":1762239030366,"user_tz":-420,"elapsed":6392,"user":{"displayName":"Oh my gust","userId":"09009155263349941429"}},"outputId":"fcfa28ff-8d05-4eaf-c289-5cde4d3dadb0"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","⚙️ Applying Original SMOTE for classes 2 and 3 ...\n","Target samples for class 2 & 3 after SMOTE ≈ 64400\n","\n","📈 After Original SMOTE:\n","Class 1: 64314\n","Class 2: 64400\n","Class 3: 64400\n","Class 4: 73062\n","Class 5: 128801\n"]}]},{"cell_type":"code","source":["# --- Cross-validation ---\n","kf = KFold(n_splits=10, shuffle=True, random_state=42)\n","accuracies, precisions, recalls, f1_scores, auc_scores = [], [], [], [], []\n","\n","for fold, (train_idx, val_idx) in enumerate(kf.split(X_train_res), 1):\n","    print(f\"\\n===== Fold {fold} =====\")\n","    X_fold_train, X_fold_val = X_train_res[train_idx], X_train_res[val_idx]\n","    y_fold_train, y_fold_val = y_train_res[train_idx], y_train_res[val_idx]\n","\n","    rf = RandomForestClassifier(random_state=42)\n","    rf.fit(X_fold_train, y_fold_train)\n","\n","    y_pred = rf.predict(X_fold_val)\n","    y_pred_proba = rf.predict_proba(X_fold_val)\n","\n","    acc = accuracy_score(y_fold_val, y_pred)\n","    precision = precision_score(y_fold_val, y_pred, average='weighted', zero_division=0)\n","    recall = recall_score(y_fold_val, y_pred, average='weighted', zero_division=0)\n","    f1 = f1_score(y_fold_val, y_pred, average='weighted', zero_division=0)\n","    y_bin = label_binarize(y_fold_val, classes=list(range(n_classes)))\n","    auc = roc_auc_score(y_bin, y_pred_proba, average='macro', multi_class='ovo')\n","\n","    accuracies.append(acc)\n","    precisions.append(precision)\n","    recalls.append(recall)\n","    f1_scores.append(f1)\n",