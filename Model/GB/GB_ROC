กเป็นไฟล์ภาพ (เลือกได้ว่าจะเป็น PNG หรือ JPG)\n","plt.savefig(\"roc_curve_gb_comparison.png\", dpi=300, bbox_inches='tight')\n","# หรือใช้ .jpg ก็ได้ เช่น:\n","# plt.savefig(\"roc_curve_comparison.jpg\", dpi=300, bbox_inches='tight')\n","\n","plt.show()\n"]}]}