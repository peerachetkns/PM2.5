ingClassifier(\n","    random_state=42,\n","    max_depth=6,\n","    learning_rate=0.05,\n","    max_iter=300,\n","    l2_regularization=0.1\n",")\n","gb_final.fit(X_resampled, y_resampled)\n","y_pred_test = gb_final.predict(X_test)\n","y_pred_proba_test = gb_final.predict_proba(X_test)"],"metadata":{"id":"FFaCvILXLwwr"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# --- Test Metrics ---\n","test_accuracy = accuracy_score(y_test, y_pred_test)\n","test_precision = precision_score(y_test, y_pred_test, average='weighted', zero_division=0)\n","test_recall = recall_score(y_test, y_pred_test, average='weighted', zero_division=0)\n","test_f1 = f1_score(y_test, y_pred_test, average='weighted', zero_division=0)\n","test_auc = roc_auc_score(\n","    label_binarize(y_test, classes=list(range(n_classes))),\n","    y_pred_proba_test,\n","    average='macro',\n","    multi_class='ovo'\n",")\n","\n","print(\"\\n📊 Cross-validation (10 folds) Metrics per Fold:\")\n","for i in range(len(accuracies)):\n","    print(f\"Fold {i+1}: \"\n","          f\"Acc={accuracies[i]:.3f}, \"\n","          f\"Prec={precisions[i]:.3f}, \"\n","          f\"Rec={recalls[i]:.3f}, \"\n","          f\"F1={f1_scores[i]:.3f}, \"\n","          f\"AUC={auc_scores[i]:.3f}\")\n","\n","# --- Mean and SD summary ---\n","acc_mean, acc_sd = np.mean(accuracies), np.std(accuracies)\n","prec_mean, prec_sd = np.mean(precisions), np.std(precisions)\n","rec_mean, rec_sd = np.mean(recalls), np.std(recalls)\n","f1_mean, f1_sd = np.mean(f1_scores), np.std(f1_scores)\n","auc_mean, auc_sd = np.mean(auc_scores), np.std(auc_scores)\n","\n","print(\"\\n📊 Cross-validation (10 folds) Avg ± SD:\")\n","print(f\"Accuracy : {acc_mean:.3f} ± {acc_sd:.3f}\")\n","print(f\"Precision: {prec_mean:.3f} ± {prec_sd:.3f}\")\n","print(f\"Recall   : {rec_mean:.3f} ± {rec_sd:.3f}\")\n","print(f\"F1-score : {f1_mean:.3f} ± {f1_sd:.3f}\")\n","print(f\"AUC      : {auc_mean:.3f} ± {auc_sd:.3f}\")\n","\n","print(\"\\n📈 Test Set Metrics:\")\n","print(f\"Accuracy: {test_accuracy:.3f}, Precision: {test_precision:.3f}, \"\n","      f\"Recall: {test_recall:.3f}, F1: {test_f1:.3f}, AUC: {test_auc:.3f}\")\n","\n","print(\"\\nClassification Report:\\n\",\n","      classification_report(\n","          y_test, y_pred_test,\n","          target_names=['Good', 'Moderate', 'Unhealthy for Sensitive', 'Unhealthy', 'Very Unhealthy'],\n","          zero_division=0\n","      ))\n","print(\"Confusion Matrix:\\n\", confusion_matrix(y_test, y_pred_test))\n"],"metadata":{"id":"8IFtShn-Lws-"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# =====================================================\n","# 🆕 SAVE ROC DATA (for ROC Curve plotting)\n","# =====================================================\n","print(\"💾 กำลังบันทึกข้อมูลสำหรับพล็อต ROC Curve...\")\n","\n","# --- Save y_test ---\n","y_test_df = pd.DataFrame(y_test, columns=[\"y_true\"])\n","\n","# --- Save predicted probabilities ---\n","proba_df = pd.DataFrame(\n","    y_pred_proba_test,\n","    columns=[f\"Class_{i}\" for i in range(y_pred_proba_test.shape[1])]\n",")\n","\n","# --- Combine and save ---\n","roc_data = pd.concat([y_test_df, proba_df], axis=1)\n","roc_data.to_csv(\"gb_adasyn_scores.csv\", index=False)\n","\n","print(\"✅ บันทึกไฟล์สำหรับพล็อต ROC Curve แล้วที่ histgb_smotetomek_roc_data.csv\")"],"metadata":{"id":"WI4qSQZdLwpm"},"execution_count":null,"outputs":[]}]}