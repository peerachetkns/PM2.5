{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[]},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"id":"pSaWXRu49O-P","executionInfo":{"status":"ok","timestamp":1762242152452,"user_tz":-420,"elapsed":6977,"user":{"displayName":"Chalermchai Nichee","userId":"15990642718241094019"}}},"outputs":[],"source":["# ======================= Gradient Boosting with SMOTE-KMeans + CSV Save =======================\n","import pandas as pd\n","import numpy as np\n","from sklearn.model_selection import KFold\n","from sklearn.preprocessing import label_binarize\n","from sklearn.metrics import (\n","    accuracy_score, classification_report, confusion_matrix,\n","    precision_score, recall_score, f1_score, roc_auc_score\n",")\n","from sklearn.ensemble import HistGradientBoostingClassifier\n","from imblearn.over_sampling import KMeansSMOTE"]},{"cell_type":"code","source":["# --- Load Train/Test Split Files ---\n","train_df = pd.read_csv(\"train_split.csv\")\n","test_df = pd.read_csv(\"test_split.csv\")"],"metadata":{"id":"frc-6qBh9dZL","executionInfo":{"status":"ok","timestamp":1762242152960,"user_tz":-420,"elapsed":481,"user":{"displayName":"Chalermchai Nichee","userId":"15990642718241094019"}}},"execution_count":2,"outputs":[]},{"cell_type":"code","source":["# --- แยก X, y ---\n","X_train = train_df.drop(columns=[\"PM2.5_level\"]).values\n","y_train = train_df[\"PM2.5_level\"].values - 1  # ปรับ label ให้เริ่มที่ 0\n","\n","X_test = test_df.drop(columns=[\"PM2.5_level\"]).values\n","y_test = test_df[\"PM2.5_level\"].values - 1\n","\n","n_classes = len(np.unique(y_train))"],"metadata":{"id":"GHPhH18o9dRw","executionInfo":{"status":"ok","timestamp":1762242152980,"user_tz":-420,"elapsed":14,"user":{"displayName":"Chalermchai Nichee","userId":"15990642718241094019"}}},"execution_count":3,"outputs":[]},{"cell_type":"code","source":["# --- Show original class distribution ---\n","class_counts = np.bincount(y_train)\n","print(\"\\n📊 Original Class Distribution:\")\n","for i, c in enumerate(class_counts, 1):\n","    print(f\"Class {i}: {c}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"-775Rh8U9dNl","executionInfo":{"status":"ok","timestamp":1762242153038,"user_tz":-420,"elapsed":55,"user":{"displayName":"Chalermchai Nichee","userId":"15990642718241094019"}},"outputId":"d2d693c7-29c9-460f-d7c4-fe99a638cc1e"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","📊 Original Class Distribution:\n","Class 1: 64314\n","Class 2: 33504\n","Class 3: 29942\n","Class 4: 73062\n","Class 5: 128801\n"]}]},{"cell_type":"code","source":["# --- Apply SMOTE-KMeans only for classes 2 and 3 ---\n","print(\"\\n⚙️ Applying SMOTE-KMeans for classes 2 and 3 ...\")\n","\n","max_class = np.max(class_counts)\n","target_count = int(max_class / 2)\n","print(f\"Target samples for class 2 & 3 after KMeansSMOTE ≈ {target_count}\")\n","\n","sampling_strategy = {\n","    1: target_count,  # class 2\n","    2: target_count   # class 3\n","}\n","\n","# --- Apply SMOTE-KMeans ---\n","kmeans_smote = KMeansSMOTE(\n","    random_state=42,\n","    sampling_strategy=sampling_strategy,\n","    cluster_balance_threshold=0.05\n",")\n","X_resampled, y_resampled = kmeans_smote.fit_resample(X_train, y_train)\n","\n","# --- Check new distribution ---\n","new_counts = np.bincount(y_resampled)\n","print(\"\\n📈 After SMOTE-KMeans:\")\n","for i, c in enumerate(new_counts, 1):\n","    print(f\"Class {i}: {c}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"yJC0pNfz9dJb","executionInfo":{"status":"ok","timestamp":1762242159689,"user_tz":-420,"elapsed":6640,"user":{"displayName":"Chalermchai Nichee","userId":"15990642718241094019"}},"outputId":"8e2b0a15-e602-4b7d-bc04-6de44833fef4"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","⚙️ Applying SMOTE-KMeans for classes 2 an