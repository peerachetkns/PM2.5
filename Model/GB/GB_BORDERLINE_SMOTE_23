ass distribution ---\n","class_counts = np.bincount(y_train)\n","print(\"\\n📊 Original Class Distribution:\")\n","for i, c in enumerate(class_counts, 1):\n","    print(f\"Class {i}: {c}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"H2rqjoYj-aAC","executionInfo":{"status":"ok","timestamp":1762241075995,"user_tz":-420,"elapsed":4,"user":{"displayName":"Chalermchai Nichee","userId":"15990642718241094019"}},"outputId":"cfd92eab-e40f-41e2-e161-284d28164976"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","📊 Original Class Distribution:\n","Class 1: 64314\n","Class 2: 33504\n","Class 3: 29942\n","Class 4: 73062\n","Class 5: 128801\n"]}]},{"cell_type":"code","source":["# --- Apply Borderline-SMOTE only for classes 2 and 3 ---\n","print(\"\\n⚙️ Applying Borderline-SMOTE for classes 2 and 3 ...\")\n","\n","max_class = np.max(class_counts)\n","target_count = int(max_class / 2)\n","print(f\"Target samples for class 2 & 3 after Borderline-SMOTE ≈ {target_count}\")\n","\n","sampling_strategy = {\n","    1: target_count,  # class 2 (index 1)\n","    2: target_count   # class 3 (index 2)\n","}\n","\n","# --- Apply Borderline-SMOTE ---\n","bsmote = BorderlineSMOTE(\n","    random_state=42,\n","    sampling_strategy=sampling_strategy,\n","    kind='borderline-1'  # ใช้ Borderline-1 (สามารถเปลี่ยนเป็น 'borderline-2' ได้)\n",")\n","X_resampled, y_resampled = bsmote.fit_resample(X_train, y_train)\n","\n","# --- Check new distribution ---\n","new_counts = np.bincount(y_resampled)\n","print(\"\\n📈 After Borderline-SMOTE:\")\n","for i, c in enumerate(new_counts, 1):\n","    print(f\"Class {i}: {c}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"nuwwVNyV-Z8H","executionInfo":{"status":"ok","timestamp":1762241113189,"user_tz":-420,"elapsed":37187,"user":{"displayName":"Chalermchai Nichee","userId":"15990642718241094019"}},"outputId":"a3c92c7e-712e-43e3-d4f7-d40909405d12"},"execution_count":5,"outputs":[{"outp